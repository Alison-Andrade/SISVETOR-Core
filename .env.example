# Copie para .env. Em desenvolvimento, preencha as credenciais abaixo.
# Em producao, use os arquivos em secrets/; estas duas variaveis nao sao usadas.
POSTGRES_DB=endemias
POSTGRES_USER=endemias
POSTGRES_PASSWORD=
JWT_SECRET=
POSTGRES_PORT=5433
API_PORT=8080
AUTH_WEB_ALLOWED_ORIGINS=http://localhost:5173

# Ative somente na primeira inicializacao, com os campos abaixo preenchidos.
BOOTSTRAP_COORDINATOR_ENABLED=false
BOOTSTRAP_COORDINATOR_NOME=
BOOTSTRAP_COORDINATOR_CPF=
BOOTSTRAP_COORDINATOR_MATRICULA=
BOOTSTRAP_COORDINATOR_EMAIL=
BOOTSTRAP_COORDINATOR_PASSWORD=
